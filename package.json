{
  "name": "bar-chart-reveal",
  "version": "2.7.1",
  "description": "配置驱动的 3D 柱状赛跑可视化与出片工具（Vue3 + ECharts-GL，任意数据集/主题/标题/形状）",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview --port 4173",
    "data": "node scripts/data/fetch-huining.mjs",
    "capture": "node scripts/capture.mjs",
    "render": "node scripts/render.mjs",
    "test": "node scripts/qa/config.test.mjs",
    "qa": "node scripts/qa/verify.mjs && node scripts/qa/interact.mjs",
    "qa:aspect": "node scripts/qa/verify-aspect.mjs",
    "qa:playback": "node scripts/qa/verify-playback.mjs",
    "qa:overlay": "node scripts/qa/verify-overlay.mjs",
    "qa:all": "npm test && node scripts/qa/verify.mjs && node scripts/qa/verify-aspect.mjs && node scripts/qa/interact.mjs && node scripts/qa/verify-playback.mjs && node scripts/qa/verify-overlay.mjs"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "echarts-gl": "^2.0.9",
    "papaparse": "^5.4.1",
    "vue": "^3.4.27"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^22.15.0",
    "vite": "^5.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
